# ========================================
# Octara Hub Environment Variables
# Copy to .env in project root
# ========================================

# --- App Core ---
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5174
APP_NAME="Octara Hub"
DEFAULT_LOCALE=en

# --- Database ---
# Local dev quick start
USE_SQLITE=True

# Docker/production database (used when USE_SQLITE=False)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=octara_hub
DB_USER=octara_hub
DB_PASSWORD=octara_hub
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=10080

# --- Storage ---
STORAGE_ROOT=./server/storage
MAX_UPLOAD_SIZE=52428800

# --- Optional Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
