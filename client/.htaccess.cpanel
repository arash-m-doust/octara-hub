# Place this file as .htaccess in your public_html (or subdomain root)
# after copying the client/dist/ contents there

RewriteEngine On

# If the request is for the API, proxy to Django (Passenger handles this)
# These rules assume Django runs at /api/ path

# If the file/directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise serve index.html (SPA routing)
RewriteRule ^(?!api/).*$ /index.html [L,QSA]
